@using HomeNow.Resources
@using System.Web
@using Core.ViewModels

@model object

@{
    // ===== Helper resx an toàn =====
    Func<string, string, string> R = (key, fallback) =>
    {
        var s = HomeTexts.ResourceManager.GetString(key, System.Threading.Thread.CurrentThread.CurrentUICulture);
        return string.IsNullOrWhiteSpace(s) ? fallback : s;
    };

    var vm = Model as HeaderBarViewModel;

    var currentLang = vm?.CurrentLang ?? System.Threading.Thread.CurrentThread.CurrentUICulture.Name;

    var favCount = vm?.FavoriteCount ?? (int)(ViewBag.FavoriteCount ?? 0);
    var favCountText = favCount > 99 ? "99+" : favCount.ToString();

    var cityName =
        !string.IsNullOrWhiteSpace(vm?.HeaderCityName) ? vm.HeaderCityName
        : (!string.IsNullOrWhiteSpace(ViewBag.HeaderCityName as string) ? (string)ViewBag.HeaderCityName : HomeTexts.CityName);

    var name =
        !string.IsNullOrWhiteSpace(vm?.CurrentUserName) ? vm.CurrentUserName
        : (Session["CurrentUserName"] as string ?? HomeTexts.Account_Default);

    var returnUrl = vm?.ReturnUrl ?? (Request?.RawUrl ?? "/");

    var JS_FavNeedLogin = HttpUtility.JavaScriptStringEncode(HomeTexts.Favorite_NeedLogin);
    var JS_FavUpdateFail = HttpUtility.JavaScriptStringEncode(HomeTexts.Favorite_UpdateFailed);
    var JS_FeatureComingSoon = HttpUtility.JavaScriptStringEncode(R("Common_FeatureComingSoon", "Tính năng đang phát triển"));

    // ✅ giống Home: đa ngôn ngữ cho popup favorites
    var JS_CommonLoading = HttpUtility.JavaScriptStringEncode(HomeTexts.Common_Loading);
    var JS_FavEmpty = HttpUtility.JavaScriptStringEncode(HomeTexts.Favorite_Empty);
    var JS_FavLoadFailed = HttpUtility.JavaScriptStringEncode(HomeTexts.Favorite_LoadFailed);
}

<style>
    .img_logo {
        height: 3rem;
        width: auto;
    }

    .home-header-left-box {
        display: flex;
        align-items: center;
        gap: 0.2rem;
    }

    .home-hero { /*background: none !important;*/
    }

    .list-hero {
        position: relative;
        background: #051636;
        padding: 7px 0 3px;
    }

        .list-hero::before {
            content: "";
            position: absolute;
            inset: 0;
        }

        .list-hero .home-hero-shell {
            position: relative;
            z-index: 1;
            width: 97%;
            margin: 0 auto;
            padding: 0 !important;
        }

    .home-hero-header {
        margin: 0;
    }

    .home-header-right-top a {
        margin: 0;
    }

    .account-hover {
        position: relative;
        display: inline-flex;
        align-items: center;
        padding-bottom: 0px;
        z-index: 99999;
    }

    .account-trigger {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        color: #fff;
        border-radius: 999px;
        background: rgba(15,23,42,0);
        border: 0;
        outline: 0;
        padding: 4px 8px;
        gap: 6px;
        user-select: none;
    }

        .account-trigger:hover {
            background: rgba(15,23,42,.55);
        }

    /* Overlay account menu */
    .hn-acc-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.35);
        z-index: 200000;
    }

    .hn-acc-panel {
        position: absolute;
        top: 43px;
        right: 12px;
        width: 280px;
        max-width: calc(100vw - 24px);
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 18px 40px rgba(0,0,0,.18);
        border: 1px solid rgba(15,23,42,.10);
        overflow: hidden;
    }

    .hn-acc-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 14px;
        color: #0f172a !important;
        text-decoration: none !important;
        font-weight: 0;
        line-height: 1;
        background: #fff;
    }

        .hn-acc-item i {
            width: 18px;
            text-align: center;
            opacity: .9;
        }

        .hn-acc-item:hover {
            background: #f1f5f9;
        }

    .hn-acc-divider {
        height: 1px;
        background: rgba(15,23,42,.08);
        margin: 0;
    }

    .hn-acc-item.logout {
        color: #dc2626 !important;
    }

        .hn-acc-item.logout:hover {
            background: #fef2f2;
        }

    /* Favorite badge */
    .fav-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        color: #fff;
    }

        .fav-wrap.has-badge i {
            color: #ff4d6d;
        }

    .fav-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        min-width: 9px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #22c55e;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .home-header-left-tagline {
        display: flex;
        align-items: end;
    }

    @@media(max-width:500px) {
        .hn-acc-panel {
            top: 39px;
            right: 10px;
            width: 53vw;
        }

        .fav-badge {
            position: absolute;
            top: 3px;
            right: 3px;
            min-width: 6px;
            height: 12px;
            padding: 0 3px;
            border-radius: 999px;
            background: #22c55e;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
    }

    /*  Favorites dropdown - copy flow từ Home */
    .hn-fav-menu {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .hn-fav-dropdown {
        position: absolute;
        top: calc(100% + 3px);
        right: -312px;
        width: 26rem;
        max-width: 70vh;
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, .10);
        box-shadow: 0 18px 40px rgba(0, 0, 0, .18);
        overflow: hidden;
        opacity: 0;
        transform: translateY(-8px);
        pointer-events: none;
        z-index: 100000;
    }

    .hn-fav-menu.open .hn-fav-dropdown {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .hn-fav-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 14px 8px;
    }

    .hn-fav-title {
        font-size: 22px;
        font-weight: 900;
        color: #0f172a;
    }

    .hn-fav-body {
        max-height: 80vh;
        overflow: auto;
        padding: 0 8px 8px;
    }

    .hn-fav-loading {
        padding: 14px;
        color: #64748b;
        font-weight: 700;
    }

    /* style list item trong dropdown (giống Home) */
    #hnFavDropdown .property-card {
        border-radius: 14px;
        overflow: hidden;
        margin: 8px 8px;
        border: 1px solid rgba(15,23,42,.08);
        background: #fff;
        position: relative;
    }

    #hnFavDropdown a.property-card-link {
        display: grid !important;
        grid-template-columns: 90px 1fr;
        align-items: center;
        padding: 2px 0 0 0;
        height: auto !important;
        text-decoration: none !important;
        color: inherit !important;
    }

    #hnFavDropdown .property-card img {
        object-fit: cover;
        width: 100%;
        height: 90%;
        display: block;
        background: #e5e7eb;
    }

    #hnFavDropdown .property-card-body {
        padding: 0 !important;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        margin-left: 3px;
    }

    #hnFavDropdown .property-card-meta {
        display: none !important;
    }

    #hnFavDropdown .property-card-price {
        text-align: left;
        margin-top: 6px;
        font-weight: 700;
    }

    #hnFavDropdown .property-card-fav {
        position: absolute;
        top: 25% !important;
        right: 20px !important;
        transform: translateY(-50%) !important;
        width: 30px;
        height: 30px;
        border-radius: 999px;
        background: rgba(15,23,42,.65);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 5;
    }

        #hnFavDropdown .property-card-fav i {
            font-size: 14px;
            color: #fff;
        }

        #hnFavDropdown .property-card-fav.is-fav {
            background: #ef4444;
        }

    @@media (max-width: 768px) {
        .hn-fav-dropdown {
            position: fixed;
            top: 70px;
            left: 12px;
            right: 12px;
            width: auto;
            max-width: none;
        }

        .hn-fav-body {
            /* max-height: calc(100vh - 180px);*/
        }
    }

    @@media (max-width: 520px) {
        #hnFavDropdown a.property-card-link {
            grid-template-columns: 68px 1fr;
            padding-right: 52px;
        }

        #hnFavDropdown .property-card img {
            width: 68px;
            height: 68px;
        }
    }
</style>

<div class="home-hero list-hero">
    <div class="home-hero-shell">
        <div class="home-hero-header">
            <a href="@Url.Action("Index", "Home")" class="home-header-left-box">
                <img class="img_logo" src="~/Assets/Cities/logo.png" />
                <div class="home-header-left">
                    <div class="home-header-left-top"><span>NhàWow</span></div>
                    <div class="home-header-left-tagline">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M12 2.5C8.96 2.5 6.5 4.96 6.5 8c0 3.74 3.39 7.47 4.96 9.15.29.31.77.31 1.06 0C14.11 15.47 17.5 11.74 17.5 8c0-3.04-2.46-5.5-5.5-5.5zm0 6.5A2 2 0 1 1 12 5a2 2 0 0 1 0 4z" />
                        </svg>
                        @HomeTexts.CityName
                    </div>
                </div>
            </a>

            <div class="home-header-right-box">
                <div class="home-header-right-top">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- ✅ Favorites dropdown giống Home -->
                        <div class="hn-fav-menu" id="hnFavMenu">
                            <a href="javascript:void(0)"
                               class="js-fav-top fav-wrap @(favCount > 0 ? "has-badge" : "")"
                               data-return="@Url.Action("Favorites", "Property")"
                               aria-haspopup="dialog"
                               aria-expanded="false">
                                <i class="fa-solid fa-heart"></i>
                                @if (favCount > 0)
                                {
                                    <span id="headerFavBadge" class="fav-badge">@favCountText</span>
                                }
                            </a>

                            <div class="hn-fav-dropdown" id="hnFavDropdown" role="dialog" aria-label="@R("Favorite_Title","Yêu thích")">
                                <div class="hn-fav-head">
                                    <div class="hn-fav-title">@R("Favorite_Title", "Yêu thích")</div>
                                </div>
                                <div class="hn-fav-body" id="hnFavBody">
                                    <div class="hn-fav-loading">@HomeTexts.Common_Loading</div>
                                </div>
                            </div>
                        </div>

                        <div class="account-hover" id="hnAccountHover">
                            <div class="account-trigger" id="hnAccountTrigger" aria-haspopup="menu" aria-expanded="false">
                                <i class="fa-solid fa-user"></i>
                                <span>@name</span>
                                <i class="fa-solid fa-caret-down" style="font-size:12px; opacity:.8;"></i>
                            </div>
                        </div>

                        <div id="hnAccountMenuOverlay" class="hn-acc-overlay" aria-hidden="true">
                            <div class="hn-acc-panel" role="menu" aria-label="@R("Account_MenuLabel","Account menu")">
                                <a class="hn-acc-item js-open-profile" href="javascript:void(0)">
                                    <i class="fa-regular fa-user"></i>
                                    @R("Account_Profile", "Thay đổi thông tin cá nhân")
                                </a>

                                <a class="hn-acc-item js-open-change-password" href="javascript:void(0)">
                                    <i class="fa-solid fa-lock"></i>
                                    @R("Account_ChangePassword", "Thay đổi mật khẩu")
                                </a>

                                <div class="hn-acc-divider"></div>

                                <a class="hn-acc-item logout" href="@Url.Action("Logout","Account")">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    @R("Account_Logout", "Đăng xuất")
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="javascript:void(0)"
                           class="js-fav-top fav-wrap"
                           data-return="@returnUrl">
                            <i class="fa-solid fa-heart"></i>
                        </a>

                        <a href="javascript:void(0)" class="js-open-login">@HomeTexts.Login</a>
                    }

                    <a href="@Url.Action("Request", "Landlord")" class="nav-post">@HomeTexts.Menu_Post</a>
                </div>

                <div class="home-header-right-bottom">
                    <a href="@Url.Action("Set", "Language", new { lang = "vi-VN", returnUrl = returnUrl })"
                       class="@(currentLang.StartsWith("vi") ? "lang-active" : "")">VI</a>
                    |
                    <a href="@Url.Action("Set", "Language", new { lang = "en-US", returnUrl = returnUrl })"
                       class="@(currentLang.StartsWith("en") ? "lang-active" : "")">EN</a>
                    |
                    <a href="@Url.Action("Set", "Language", new { lang = "zh-CN", returnUrl = returnUrl })"
                       class="@(currentLang.StartsWith("zh") ? "lang-active" : "")">中文</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // tránh init nhiều lần
    if (window.__TopHeaderBarInitedV3) return;
    window.__TopHeaderBarInitedV3 = true;

    var MSG_COMING = '@JS_FeatureComingSoon';
    var MSG_NEED_LOGIN = '@JS_FavNeedLogin';
    var MSG_UPDATE_FAIL = '@JS_FavUpdateFail';

    var MSG_LOADING = '@JS_CommonLoading';
    var MSG_FAV_EMPTY = '@JS_FavEmpty';
    var MSG_FAV_LOAD_FAIL = '@JS_FavLoadFailed';

    function waitForJQ(cb) {
        if (window.jQuery && window.jQuery.fn) return cb(window.jQuery);
        setTimeout(function () { waitForJQ(cb); }, 30);
    }

    // Account overlay (giữ nguyên)
    (function () {
        var trigger = document.getElementById('hnAccountTrigger');
        var overlay = document.getElementById('hnAccountMenuOverlay');
        if (!trigger || !overlay) return;

        function openMenu() {
            overlay.style.display = 'block';
            overlay.setAttribute('aria-hidden', 'false');
            trigger.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
            overlay.style.display = 'none';
            overlay.setAttribute('aria-hidden', 'true');
            trigger.setAttribute('aria-expanded', 'false');
        }
        window.__closeAccountMenu = closeMenu;

        trigger.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (overlay.style.display === 'block') closeMenu();
            else openMenu();
        });

        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeMenu();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeMenu();
        });

        document.addEventListener('click', function () { closeMenu(); });
    })();

    waitForJQ(function ($) {

        // ====== GLOBAL STATE ======
        window.__isAuth = @User.Identity.IsAuthenticated.ToString().ToLower();
        window.__favIds = window.__favIds || [];

        function normalizeIds(ids) {
            ids = ids || [];
            var map = {};
            for (var i = 0; i < ids.length; i++) map[String(ids[i])] = true;
            var out = [];
            for (var k in map) out.push(parseInt(k, 10));
            return out;
        }

        // ====== BADGE ======
        window.updateHeaderFavBadge = window.updateHeaderFavBadge || function (count) {
            count = parseInt(count || 0, 10);
            var $wrap = $('.js-fav-top.fav-wrap');
            if ($wrap.length === 0) return;

            var $badge = $('#headerFavBadge');
            if (count > 0) {
                var text = count > 99 ? '99+' : String(count);
                $wrap.addClass('has-badge');
                if ($badge.length === 0) $wrap.append('<span id="headerFavBadge" class="fav-badge">' + text + '</span>');
                else $badge.text(text);
            } else {
                $wrap.removeClass('has-badge');
                if ($badge.length) $badge.remove();
            }
        };

        // ====== APPLY FAVORITES TO HEARTS ======
        window.applyFavoriteIds = window.applyFavoriteIds || function (ids, $scope) {
            ids = normalizeIds(ids || []);
            var set = {};
            for (var i = 0; i < ids.length; i++) set[String(ids[i])] = true;

            var $root = ($scope && $scope.length) ? $scope : $(document);
            $root.find('.js-fav-toggle').each(function () {
                var pid = $(this).data('id');
                $(this).toggleClass('is-fav', !!set[String(pid)]);
            });
        };

        // ====== REFRESH FROM SERVER ======
        window.refreshHeaderFav = window.refreshHeaderFav || function () {
            return $.get('@Url.Action("HeaderFavoriteInfo", "Property")')
                .done(function (res) {
                    if (!res) return;
                    window.__isAuth = !!res.isAuth;
                    window.__favIds = normalizeIds(res.favoriteIds || []);
                    window.updateHeaderFavBadge(res.favoriteCount || 0);
                    window.applyFavoriteIds(window.__favIds);
                });
        };

        // ====== DROPDOWN ======
        (function () {
            var $menu = $('#hnFavMenu');
            var $body = $('#hnFavBody');

            function openFavDropdown() {
                if (!$menu.length) return;

                $menu.addClass('open');
                $menu.find('.js-fav-top').attr('aria-expanded', 'true');

                if ($body.length) $body.html('<div class="hn-fav-loading">' + MSG_LOADING + '</div>');

                $.ajax({
                    url: '@Url.Action("FavoritesPopup", "Home")',
                    type: 'GET',
                    dataType: 'text',
                    cache: false
                })
                .done(function (text) {
                    try {
                        var obj = JSON.parse(text);
                        if (obj && obj.needLogin) {
                            closeFavDropdown();
                            if (window.loginModal && typeof window.loginModal.open === 'function') {
                                window.loginModal.open(window.location.pathname + window.location.search);
                            } else {
                                alert(MSG_NEED_LOGIN);
                            }
                            return;
                        }
                    } catch (e) { }

                    var html = (text || '').trim();
                    if (!html) {
                        $body.html('<div class="hn-fav-loading">' + MSG_FAV_EMPTY + '</div>');
                        return;
                    }

                    $body.html(html);
                    window.applyFavoriteIds(window.__favIds, $body);
                })
                .fail(function () {
                    $body.html('<div class="hn-fav-loading" style="color:#ef4444;">' + MSG_FAV_LOAD_FAIL + '</div>');
                });
            }

            function closeFavDropdown() {
                if (!$menu.length) return;
                $menu.removeClass('open');
                $menu.find('.js-fav-top').attr('aria-expanded', 'false');
            }

            window.favDropdown = { open: openFavDropdown, close: closeFavDropdown };

            $(document).off('click.hnFavTop', '.js-fav-top')
                       .on('click.hnFavTop', '.js-fav-top', function (e) {
                e.preventDefault();
                e.stopPropagation();

                if (!window.__isAuth) {
                    var returnUrl = $(this).data('return') || (window.location.pathname + window.location.search);
                    if (window.loginModal && typeof window.loginModal.open === 'function') {
                        window.loginModal.open(returnUrl);
                    } else {
                        window.location.href = '@Url.Action("Login", "Account")' + '?returnUrl=' + encodeURIComponent(returnUrl);
                    }
                    return;
                }

                if ($menu.hasClass('open')) closeFavDropdown();
                else openFavDropdown();
            });

            $(document).off('click.hnFavInside', '#hnFavDropdown')
                       .on('click.hnFavInside', '#hnFavDropdown', function (e) { e.stopPropagation(); });

            $(document).off('click.hnFavDoc')
                       .on('click.hnFavDoc', function () { closeFavDropdown(); });

            $(document).off('keydown.hnFavEsc')
                       .on('keydown.hnFavEsc', function (e) { if (e.key === 'Escape') closeFavDropdown(); });
        })();

        // ====== TOGGLE FAVORITE (QUAN TRỌNG: update __favIds để không bị revert) ======
        $(document).off('click.hnFavToggle', '.js-fav-toggle')
                   .on('click.hnFavToggle', '.js-fav-toggle', function (e) {

            e.preventDefault();
            e.stopPropagation();

            var $btn = $(this);
            var propertyId = $btn.data('id');

            $.ajax({
                url: '@Url.Action("ToggleFavorite", "Property")',
                type: 'POST',
                data: { propertyId: propertyId },
                success: function (res) {
                    if (!res) return;

                    if (res.needLogin) {
                        if (window.loginModal && typeof window.loginModal.open === 'function') {
                            window.loginModal.open(window.location.pathname + window.location.search);
                        } else {
                            alert(MSG_NEED_LOGIN);
                        }
                        return;
                    }

                    if (res.success) {
                        // 1) update state chuẩn
                        var isFav = !!res.isFavorite;

                        // 2) update __favIds ngay (đây là chỗ fix “1s revert”)
                        var ids = (res.favoriteIds && res.favoriteIds.length >= 0)
                            ? res.favoriteIds
                            : window.__favIds;

                        ids = normalizeIds(ids);

                        if (!res.favoriteIds) {
                            // nếu server không trả ids (trường hợp cũ) -> tự add/remove
                            var set = {};
                            for (var i = 0; i < ids.length; i++) set[String(ids[i])] = true;
                            if (isFav) set[String(propertyId)] = true;
                            else delete set[String(propertyId)];
                            ids = [];
                            for (var k in set) ids.push(parseInt(k, 10));
                        }

                        window.__favIds = normalizeIds(ids);

                        // 3) apply cho toàn trang + badge
                        window.applyFavoriteIds(window.__favIds);
                        if (typeof res.favoriteCount !== 'undefined') window.updateHeaderFavBadge(res.favoriteCount);
                        else window.updateHeaderFavBadge(window.__favIds.length);

                        window.__isAuth = true;

                        // 4) nếu dropdown mở -> reload list cho đúng
                        if ($('#hnFavMenu').hasClass('open') && window.favDropdown && window.favDropdown.open) {
                            window.favDropdown.open();
                        }
                    }
                },
                error: function () { alert(MSG_UPDATE_FAIL); }
            });
        });

        // init
        $(function () { window.refreshHeaderFav(); });
    });

})();
</script>


